{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity Bedrock",
  "description": "Compiled Continuity rule engine. Connected glass is delegated to BedrockTools.",
  "type": "object",
  "properties": {
    "version": {"type":"integer", "readOnly":true},
    "enabled": {"type":"boolean"},
    "enableRuleEngine": {
      "type":"boolean",
      "description":"Enable compiled Continuity .properties rules."
    },
    "diagnostics": {"type":"boolean"},
    "maxDiagnosticLogs": {"type":"integer", "minimum":0, "maximum":32}
  },
  "additionalProperties": false
}
